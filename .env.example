# Copy to .env.local for local work. .env* is git-ignored (this file excepted).

# --- server-only -------------------------------------------------------------
# Never prefix these with VITE_: a VITE_ value is inlined into the browser
# bundle, where anyone can read it. On Vercel, set them in Project Settings →
# Environment Variables (Production and Preview), not in git.
PLANNER_PROVIDER_KEY=
PLANNER_PROVIDER_URL=https://api.openai.com/v1/chat/completions
PLANNER_MODEL=gpt-4o-mini

# --- public ------------------------------------------------------------------
# The same-origin route the browser calls. Safe to commit: it is a URL, not a key.
# Leave it unset unless that route is actually served, or every run will make a
# request that cannot succeed. With CODELENS_PLANNER_DEV_MOCK=1, set it to
# /api/plan?case=tree (see server/planner/dev.js for the other scenarios).
# VITE_PLANNER_ENDPOINT=/api/plan

# --- local only --------------------------------------------------------------
# Mounts /api/plan in the Vite dev server with a mock upstream, so the real
# client and handler can be exercised without a key. Never set in production.
# CODELENS_PLANNER_DEV_MOCK=1
